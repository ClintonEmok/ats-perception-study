# Set NEXT_PUBLIC_CONVEX_URL to the Convex deployment the study should talk to.
# Example: NEXT_PUBLIC_CONVEX_URL=https://ats-perception-study-prod.convex.cloud
NEXT_PUBLIC_CONVEX_URL=

# CONVEX_DEPLOY_KEY is only used in CI to run `npx convex deploy --prod`.
# Do NOT expose this to the client.
CONVEX_DEPLOY_KEY=
