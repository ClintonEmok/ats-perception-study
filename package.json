    "video:render-showcase": "remotion render video/index.ts DashboardShowcase output/dashboard-showcase/dashboard-showcase.mp4 --gl=angle",
    "video:still-showcase": "remotion still video/index.ts DashboardShowcase output/dashboard-showcase/dashboard-showcase-summary.png --frame=520",
    "video:render-visual-allocation": "remotion render video/index.ts VisualAllocationConcept output/visual-allocation/visual-allocation.mp4 --gl=angle",
    "video:render-wang": "remotion render video/index.ts WangTimeslicing output/wang-timeslicing/wang-timeslicing.mp4 --gl=angle",
    "video:render-wang-graphs": "remotion render video/index.ts WangTimeslicingWithGraphs output/wang-timeslicing/wang-timeslicing-graphs.mp4 --gl=angle",
