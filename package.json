    "video:render-equal-time": "remotion render video/index.ts EqualTimeConcept output/equal-time-concept/equal-time-concept.mp4 --gl=angle",
    "video:render-equal-time-week": "remotion render video/index.ts EqualTimeWeek output/equal-time-week/equal-time-week.mp4",
