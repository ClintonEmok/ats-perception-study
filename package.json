    "video:still-wang-graphs": "remotion still video/index.ts WangTimeslicingWithGraphs output/wang-timeslicing/wang-timeslicing-graphs-summary.png --frame=360",
    "video:data": "node scripts/generate-remotion-week-data.mjs",
    "video:map-data": "node scripts/generate-remotion-map-data.mjs",
    "postinstall": "patch-package && mkdir -p node_modules/duckdb/lib/binding/3 && ln -sf ../duckdb.node node_modules/duckdb/lib/binding/3/duckdb.node"
  },
