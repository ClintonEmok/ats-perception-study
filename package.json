    "video:studio": "remotion studio video/index.ts",
    "video:still": "remotion still video/index.ts ConstructingDashboard output/constructing-dashboard/constructing-dashboard.png --frame=870",
    "video:render": "remotion render video/index.ts ConstructingDashboard output/constructing-dashboard/constructing-dashboard.mp4",
